    <!-- [FIX 2026-04-28] Extension fields em TGFCAB (tabela nativa Sankhya).
         Sem esta declaracao, o Sankhya nao registra a coluna no TDDDIC e o
         VO de CabecalhoNota nao expoe o atributo, mesmo a coluna fisica
         existindo (criada via dbscripts/V2.xml e V21.xml). Resultado:
         "Propriedade AD_DESCONTO_FAST nao existe para o ValueObject
         CabecalhoNota.ValueObject" em toda importacao FC.
         dataType F = Float/Decimal (BigDecimal). -->
    <field name="AD_DESCONTO_FAST" table="TGFCAB" dataType="F" presentationType="P" calculated="N" allowSearch="N" allowDefault="S" visibleOnSearch="N" isPresentation="N" order="0">
      <description><![CDATA[Cupom de desconto Fastchannel]]></description>
    </field>
    <field name="AD_NUMFAST" table="TGFCAB" dataType="S" presentationType="P" calculated="N" allowSearch="S" allowDefault="S" visibleOnSearch="S" isPresentation="N" order="0">
      <description><![CDATA[Numero do pedido na Fastchannel]]></description>
    </field>
    <field name="AD_FASTCHANNEL_ID" table="TGFCAB" dataType="S" presentationType="P" calculated="N" allowSearch="S" allowDefault="S" visibleOnSearch="S" isPresentation="N" order="0">
      <description><![CDATA[ID do pedido na Fastchannel]]></description>
    </field>
    <!-- [FIX 2026-04-30] AD_PARCELAS_FAST: numero de parcelas do cartao de credito utilizado no pedido FC.
         Util para auditoria/relatorio financeiro saber quantas parcelas teve cada pedido FC.
         Os encargos em si (R$) sao gravados em VLRJURO (campo nativo Sankhya). -->
    <field name="AD_PARCELAS_FAST" table="TGFCAB" dataType="I" presentationType="P" calculated="N" allowSearch="N" allowDefault="S" visibleOnSearch="N" isPresentation="N" order="0">
      <description><![CDATA[Numero de parcelas do cartao Fastchannel]]></description>
    </field>
    <!-- AD_MCAPORTAL NAO declarado: a coluna nao existe fisicamente em TGFCAB
         (nao tem dbscript). Declarar aqui causa Sankhya a tentar registrar no
         TDDDIC e falhar com "Metadata nao encontrado" em toda chamada. O codigo
         FC ja trata isso via supportsCabField()/hasColumn() guards: se a coluna
         nao existir, o set eh pulado silenciosamente. -->
  </fields>
