INSERT INTO AD_ICONICCFG (CHAVE, DESCRICAO, TIPO, TEXTO, NUMINT, LOGICO, DATA)
            SELECT CHAVE, DESCRICAO, TIPO, TEXTO, NUMINT, LOGICO, DATA
            FROM TSIPAR t
            WHERE CHAVE IN (
                'ICONIC_API_BASE_URL',
                'ICONIC_OAUTH_URL',
                'ICONIC_CLIENT_ID',
                'ICONIC_CLIENT_SECRET',
                'ICONIC_OAUTH_SCOPE',
                'ICONIC_API_MAX_RETRIES',
                'ICONIC_VIEW_NAME',
                'ICONIC_LAST_SYNC_DATE'
            )
            AND NOT EXISTS (SELECT 1 FROM AD_ICONICCFG a WHERE a.CHAVE = t.CHAVE)


