                        "schema": {
                            "type": "int"
                        }
                    },
                    {
                        "name": "Accept",
                        "in": "header",
                        "description": "Anuncia quais tipos de conteúdo, expressos como MIME types, o seu cliente é capaz de entender.",
                        "required": true,
                        "schema": {
                            "enum": [
                                "application/json"
                            ],
                            "type": "string",
                            "default": "application/json"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Resposta de sucesso recebida após a consulta de uma determinada faixa de preço escalonado.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Informa__es_Detalhadas_de_uma_Faixa_de_Pre_o_Escalonado"
                                },
                                "example": {
                                    "Success": true,
                                    "HttpStatusCode": 200,
                                    "RequestParams": {
                                        "PriceTableId": 2,
                                        "ProductId": "31428700",
                                        "BatchId": 5
                                    },
                                    "Payload": {
                                        "BatchId": 5,
                                        "ProductId": "31428700",
                                        "ProductName": "Havoline Semissintético SAE 10W-40 API SN- Granel",
                                        "PriceTableId": 2,
                                        "PriceTableName": "ÁTRIA - Tabela de Preços",
                                        "UnitaryPrice": 9000,
                                        "MinimumBatchSize": 1000,
                                        "MaximumBatchSize": 9999,
                                        "UnitaryPriceForBatch": 7500,
                                        "BatchDisabled": false
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/prices/{ProductId}/batches/filter/{Quantity}": {
            "get": {
                "tags": [
                    "Preços Escalonados"
                ],
                "summary": "FilterProductPriceBatch",
                "description": "Obtém as informações detalhadas de uma faixa de preço escalonado existente para um dado produto, em uma determinada tabela de preços, considerando uma quantidade específica a ser comercializada.\n\n**Observação! Caso a sua chave de assinatura esteja vinculada a uma tabela de preços específica, o parâmetro \"PriceTableId\" será preenchido automaticamente para todas as suas requisições, e portanto não precisará ser enviado.**",
