                "tags": [
                    "Preços Escalonados"
                ],
                "summary": "GetProductPriceBatch",
                "description": "Obtém as informações detalhadas de uma faixa de preço escalonado existente para um dado produto, em uma determinada tabela de preços.",
                "operationId": "5fb3df520c6baf4024e0d3b9",
                "parameters": [
                    {
                        "name": "ProductId",
                        "in": "path",
                        "description": "Identificação única (SKU) do produto a ser utilizado como filtro dos preços desejados.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "BatchId",
                        "in": "path",
                        "description": "Identificador único (ID) da faixa de preço escalonado que será atualizada.",
